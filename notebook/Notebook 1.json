				]
			},
			{
				"cell_type": "code",
				"source": [
					"for nama in [\"A. Parquet tanpa partisi\", \"C. Delta kota+bulan\"]:\n",
					"    print(\"=====\", nama)\n",
					"    query_uji(skenario[nama]).explain()\n",
					"\n",
					"print(\"===== C, filter pm2_5 > 100\")\n",
					"skenario[\"C. Delta kota+bulan\"].filter(F.col(\"pm2_5_ug_m3\") > 100).explain()"
				],
				"execution_count": 15
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Caching: tiga agregasi tanpa cache vs dengan cache"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"df_jkt = spark.read.format(\"delta\").load(path_partisi).filter(F.col(\"kota\") == \"jakarta\")\n",
					"\n",
					"def tiga_agregasi(df):\n",
					"    df.groupBy(\"bulan\").agg(F.avg(\"pm2_5_ug_m3\")).collect()\n",
					"    df.groupBy(\"kategori_pm25\").count().collect()\n",
					"    df.agg(F.max(\"temperature_2m\"), F.min(\"temperature_2m\")).collect()\n",
					"\n",
					"ukur(\"D. Tanpa cache\", \"3 agregasi\", lambda: tiga_agregasi(df_jkt), ulang=2)\n",
					"\n",
					"df_jkt.cache()\n",
					"ukur(\"E. Dengan cache\", \"isi cache\", lambda: df_jkt.count())\n",
					"ukur(\"E. Dengan cache\", \"3 agregasi\", lambda: tiga_agregasi(df_jkt), ulang=2)\n",
					"df_jkt.unpersist()"
				],
				"execution_count": 16
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Update data Delta lalu time travel ke versi sebelumnya"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"dt = DeltaTable.forPath(spark, path_partisi)\n",
					"v_lama = dt.history(1).select(\"version\").first()[0]\n",
					"\n",
					"def pm25_jkt_jan(df):\n",
					"    return (df.filter((F.col(\"kota\") == \"jakarta\") & (F.col(\"bulan\") == \"2026-01\"))\n",
					"              .agg(F.round(F.avg(\"pm2_5_ug_m3\"), 2)).first()[0])\n",
					"\n",
					"sebelum = pm25_jkt_jan(spark.read.format(\"delta\").load(path_partisi))\n",
					"dt.update(\"kota = 'jakarta' AND bulan = '2026-01'\", {\"pm2_5_ug_m3\": \"pm2_5_ug_m3 + 10\"})\n",
					"sesudah = pm25_jkt_jan(spark.read.format(\"delta\").load(path_partisi))\n",
					"versi_lama = pm25_jkt_jan(spark.read.format(\"delta\").option(\"versionAsOf\", v_lama).load(path_partisi))\n",
					"\n",
					"print(\"Sebelum update :\", sebelum)\n",
					"print(\"Sesudah update :\", sesudah)\n",
					"print(f\"Versi {v_lama}       :\", versi_lama)\n",
					"display(dt.history().select(\"version\", \"timestamp\", \"operation\", \"operationMetrics\"))"
				],
				"execution_count": 17
