				"source": [
					"# Pertemuan 5"
				]
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"konfigurasi\n",
					""
				]
			},
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F\n",
					"from pyspark.sql.window import Window\n",
					"\n",
					"storage    = \"adls1tcba\"\n",
					"aqi_path   = f\"abfss://datacuaca@{storage}.dfs.core.windows.net\"\n",
					"cuaca_path = f\"abfss://cuaca@{storage}.dfs.core.windows.net\"\n",
					"curated    = f\"abfss://curated@{storage}.dfs.core.windows.net\"\n",
					"\n",
					"kota = {\n",
					"    \"bandung\":   (-6.9175, 107.6191), \"denpasar\":  (-8.6705, 115.2126),\n",
					"    \"jakarta\":   (-6.2088, 106.8456), \"semarang\":  (-6.9667, 110.4167),\n",
					"    \"surabaya\":  (-7.2575, 112.7521), \"surakarta\": (-7.5755, 110.8243),\n",
					"}"
				],
				"execution_count": 2
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"baca data semua kota dan bulan sekaligus"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"aqi_raw = (spark.read.option(\"header\", True)\n",
					"           .csv(f\"{aqi_path}/raw/data/*/*/*.csv\")\n",
					"           .withColumn(\"file\", F.input_file_name())\n",
					"           .withColumn(\"kota\", F.regexp_extract(\"file\", r\"/([a-z]+)/\\d{2}/\", 1))\n",
					"           .drop(\"file\"))\n",
					"\n",
					"aqi_raw.printSchema()\n",
					"display(aqi_raw.groupBy(\"kota\").count().orderBy(\"kota\"))"
				],
				"execution_count": 3
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"ambil data cuaca per jam dan simpann ke container cuaca"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"import time, requests, pandas as pd\n",
					"\n",
					"def ambil_cuaca(lat, lon, percobaan=5):\n",
					"    for i in range(percobaan):\n",
					"        try:\n",
					"            r = requests.get(\"https://archive-api.open-meteo.com/v1/archive\", params={\n",
					"                \"latitude\": lat, \"longitude\": lon,\n",
					"                \"start_date\": \"2026-01-01\", \"end_date\": \"2026-09-30\",\n",
					"                \"hourly\": \"temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m\",\n",
					"                \"timezone\": \"Asia/Jakarta\"}, timeout=(20, 120))\n",
					"            r.raise_for_status()\n",
					"            return pd.DataFrame(r.json()[\"hourly\"])\n",
					"        except Exception as e:\n",
					"            print(f\"  percobaan {i+1} gagal: {type(e).__name__}, coba lagi...\")\n",
					"            time.sleep(5 * (i + 1))\n",
					"    raise RuntimeError(\"Open-Meteo tidak bisa dihubungi\")\n",
					"\n",
					"frames = []\n",
					"for k, (lat, lon) in kota.items():\n",
					"    print(\"Ambil cuaca:\", k)\n",
					"    df = ambil_cuaca(lat, lon)\n",
					"    df[\"kota\"] = k\n",
					"    frames.append(df)\n",
					"    time.sleep(2)\n",
					"\n",
					"cuaca_raw = spark.createDataFrame(pd.concat(frames))\n",
					"print(\"Baris cuaca:\", cuaca_raw.count())\n",
					"display(cuaca_raw.limit(10))\n",
					""
				],
				"execution_count": 4
			},
			{
