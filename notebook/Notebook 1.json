				"source": [
					"gabung.write.mode(\"overwrite\").partitionBy(\"kota\").parquet(f\"{curated}/polusi_cuaca\")\n",
					"\n",
					"hasil = spark.read.parquet(f\"{curated}/polusi_cuaca\")\n",
					"display(hasil.groupBy(\"kota\").agg(\n",
					"    F.count(\"*\").alias(\"jumlah_jam\"),\n",
					"    F.round(F.avg(\"pm2_5_ug_m3\"), 1).alias(\"rata_pm25\"),\n",
					"    F.round(F.avg(\"temperature_2m\"), 1).alias(\"rata_suhu\")).orderBy(\"kota\"))"
				],
				"execution_count": 10
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"# Pertemuan 8"
				]
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Path output dan fungsi pengukur"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"import time\n",
					"from delta.tables import DeltaTable\n",
					"\n",
					"p8            = f\"{curated}/pertemuan8\"\n",
					"path_parquet  = f\"{p8}/A_parquet_flat\"\n",
					"path_delta    = f\"{p8}/B_delta_flat\"\n",
					"path_partisi  = f\"{p8}/C_delta_kota_bulan\"\n",
					"path_p5       = f\"{curated}/polusi_cuaca\"\n",
					"\n",
					"hasil_ukur, hasil_folder = [], []\n",
					"\n",
					"def ukur(skenario, tahap, fn, ulang=1):\n",
					"    for i in range(ulang):\n",
					"        t0 = time.time()\n",
					"        out = fn()\n",
					"        d = round(time.time() - t0, 2)\n",
					"        label = tahap if ulang == 1 else f\"{tahap} (run {i+1})\"\n",
					"        hasil_ukur.append((skenario, label, d))\n",
					"        print(f\"{skenario} | {label}: {d} dtk\")\n",
					"    return out\n",
					"\n",
					"def info_folder(path):\n",
					"    n, b = 0, 0\n",
					"    for f in mssparkutils.fs.ls(path):\n",
					"        nama = f.name.rstrip(\"/\")\n",
					"        if nama.startswith(\"_\"):\n",
					"            continue\n",
					"        if f.isDir:\n",
					"            n2, b2 = info_folder(f\"{path}/{nama}\")\n",
					"            n, b = n + n2, b + b2\n",
					"        elif nama.endswith(\".parquet\"):\n",
					"            n, b = n + 1, b + f.size\n",
					"    return n, b\n",
					"\n",
					"def catat_folder(skenario, path):\n",
					"    n, b = info_folder(path)\n",
					"    hasil_folder.append((skenario, n, round(b / 1024 / 1024, 2)))\n",
					"    print(f\"{skenario}: {n} file, {b/1024/1024:.2f} MB\")"
				],
				"execution_count": 11
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Tambah kolom tanggal, jam, kategori PM2.5 lalu cache"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"data = (gabung\n",
					"        .withColumn(\"tanggal\", F.to_date(\"waktu\"))\n",
					"        .withColumn(\"jam\", F.hour(\"waktu\"))\n",
					"        .withColumn(\"kategori_pm25\",\n",
					"                    F.when(F.col(\"pm2_5_ug_m3\") <= 15.5, \"baik\")\n",
					"                     .when(F.col(\"pm2_5_ug_m3\") <= 55.4, \"sedang\")\n",
					"                     .when(F.col(\"pm2_5_ug_m3\") <= 150.4, \"tidak sehat\")\n",
					"                     .otherwise(\"sangat tidak sehat\")))\n",
					"\n",
					"data.cache()\n",
					"n = ukur(\"Transformasi\", \"cache\", lambda: data.count())\n",
					"print(\"Jumlah baris:\", n)"
				],
				"execution_count": 12
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Tulis tiga versi: Parquet, Delta, Delta berpartisi kota + bulan"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"ukur(\"A. Parquet tanpa partisi\", \"tulis\",\n",
					"     lambda: data.coalesce(6).write.mode(\"overwrite\").parquet(path_parquet))\n",
					"ukur(\"B. Delta tanpa partisi\", \"tulis\",\n",
					"     lambda: data.coalesce(6).write.format(\"delta\").mode(\"overwrite\").save(path_delta))\n",
					"ukur(\"C. Delta kota+bulan\", \"tulis\",\n",
					"     lambda: data.repartition(\"kota\", \"bulan\").write.format(\"delta\").mode(\"overwrite\")\n",
					"                 .partitionBy(\"kota\", \"bulan\").save(path_partisi))\n",
					"\n",
					"catat_folder(\"A. Parquet tanpa partisi\", path_parquet)\n",
					"catat_folder(\"B. Delta tanpa partisi\", path_delta)\n",
					"catat_folder(\"C. Delta kota+bulan\", path_partisi)\n",
					"catat_folder(\"P5. Parquet partisi kota\", path_p5)"
				],
				"execution_count": 13
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Query uji: PM2.5 Jakarta bulan Maret"
				]
			},
			{
				"cell_type": "code",
				"source": [
					"def query_uji(df):\n",
					"    return (df.filter((F.col(\"kota\") == \"jakarta\") & (F.col(\"bulan\") == \"2026-03\"))\n",
					"              .groupBy(\"kota\", \"bulan\")\n",
					"              .agg(F.count(\"*\").alias(\"jam\"),\n",
					"                   F.round(F.avg(\"pm2_5_ug_m3\"), 2).alias(\"rata_pm25\"),\n",
					"                   F.max(\"pm2_5_ug_m3\").alias(\"maks_pm25\")))\n",
					"\n",
					"skenario = {\n",
					"    \"P5. Parquet partisi kota\": spark.read.parquet(path_p5),\n",
					"    \"A. Parquet tanpa partisi\": spark.read.parquet(path_parquet),\n",
					"    \"B. Delta tanpa partisi\":   spark.read.format(\"delta\").load(path_delta),\n",
					"    \"C. Delta kota+bulan\":      spark.read.format(\"delta\").load(path_partisi),\n",
					"}\n",
					"\n",
					"for nama, df in skenario.items():\n",
					"    print(nama, \"->\", query_uji(df).first())\n",
					"\n",
					"for nama, df in skenario.items():\n",
					"    ukur(nama, \"query\", lambda df=df: query_uji(df).collect(), ulang=3)"
				],
				"execution_count": 14
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
