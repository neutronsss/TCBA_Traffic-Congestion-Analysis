			},
			{
				"cell_type": "code",
				"source": [
					"polutan = [\"pm10_ug_m3\", \"pm2_5_ug_m3\", \"no2_ug_m3\", \"so2_ug_m3\", \"o3_ug_m3\", \"co_ug_m3\"]\n",
					"cuaca_cols = [\"temperature_2m\", \"relative_humidity_2m\", \"precipitation\", \"wind_speed_10m\"]\n",
					"\n",
					"aqi = aqi_raw.withColumn(\"waktu\", F.to_timestamp(\"waktu\", \"yyyy-MM-dd HH:mm:ss\"))\n",
					"for c in polutan:\n",
					"    aqi = aqi.withColumn(c, F.col(c).cast(\"double\"))\n",
					"\n",
					"cuaca = (cuaca_raw.withColumn(\"waktu\", F.to_timestamp(\"time\", \"yyyy-MM-dd'T'HH:mm\"))\n",
					"                  .drop(\"time\"))\n",
					"for c in cuaca_cols:\n",
					"    cuaca = cuaca.withColumn(c, F.col(c).cast(\"double\"))\n",
					"\n",
					"aqi.printSchema()\n",
					"cuaca.printSchema()"
				],
				"execution_count": 7
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"Cleaning\n",
					"\n",
					"Langkah cleaning-nya:\n",
					"\n",
					"NaN dan nilai negatif diubah jadi null.\n",
					"Baris tanpa kota atau waktu dibuang, begitu juga duplikat.\n",
					"Nilai null diisi rata-rata harian kota tersebut."
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"def bersihkan(df, cols):\n",
					"    for c in cols:\n",
					"        df = df.withColumn(c, F.when(F.isnan(c) | (F.col(c) < 0), None).otherwise(F.col(c)))\n",
					"    df = df.dropna(subset=[\"kota\", \"waktu\"]).dropDuplicates([\"kota\", \"waktu\"])\n",
					"    w = Window.partitionBy(\"kota\", F.to_date(\"waktu\"))\n",
					"    for c in cols:\n",
					"        df = df.withColumn(c, F.coalesce(F.col(c), F.round(F.avg(c).over(w), 2)))\n",
					"    return df.dropna(subset=cols)\n",
					"\n",
					"aqi_bersih   = bersihkan(aqi, polutan)\n",
					"cuaca_bersih = bersihkan(cuaca, cuaca_cols)\n",
					"\n",
					"display(cek_null(aqi_bersih))     # screenshot \"sesudah\""
				],
				"execution_count": 8
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"join polusi + cuaca"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"gabung = (aqi_bersih.join(cuaca_bersih, on=[\"kota\", \"waktu\"], how=\"inner\")\n",
					"          .withColumn(\"bulan\", F.date_format(\"waktu\", \"yyyy-MM\"))\n",
					"          .orderBy(\"kota\", \"waktu\"))\n",
					"\n",
					"print(\"Polusi:\", aqi_bersih.count(), \"| Cuaca:\", cuaca_bersih.count(), \"| Gabung:\", gabung.count())\n",
					"display(gabung.limit(20))"
				],
				"execution_count": 9
