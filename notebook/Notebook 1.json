				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"def cek_null(df):\n",
					"    return df.select([F.sum(F.when(F.col(c).isNull() | (F.col(c) == \"\") | (F.col(c) == \"NaN\"), 1)\n",
					"                      .otherwise(0)).alias(c) for c in df.columns])\n",
					"\n",
					"display(cek_null(aqi_raw))\n",
					"display(cek_null(cuaca_raw))"
				],
				"execution_count": 6
