{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "LookupKota",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_cities",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FilterAktif",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "LookupKota",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupKota').output.value",
						"type": "Expression"
					},
					"condition": {
						"value": "@equals(item().active, '1')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachKota",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "FilterAktif",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('FilterAktif').output.Value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyCuaca",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_api_cuaca",
									"type": "DatasetReference",
									"parameters": {
										"lat": {
											"value": "@item().lat",
											"type": "Expression"
										},
										"lon": {
											"value": "@item().lon",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ls_adls_out",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@concat('cuaca_', item().kota,'_2026.json')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-26T08:35:38Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}